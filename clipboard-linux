import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import GLib, Gdk, Gtk, Pango  # noqa: E402


def _fmt_rel_time(ts):
    delta = max(0.0, time.time() - ts)
    if delta < 60:
        return "just now"
    if delta < 3600:
        return "{} min ago".format(int(delta // 60))
    if delta < 86400:
        return "{} h ago".format(int(delta // 3600))
    if delta < 172800:
        return "yesterday"
    return time.strftime("%Y-%m-%d", time.localtime(ts))


def _preview_text(content):
    lines = content.splitlines()
    if not lines:
        return "(whitespace)"
    text = "\n".join(lines[:2])
    if len(lines) > 2:
        text += " ..."
    return text


class ClipboardDialog(Gtk.Window):
    def __init__(self, daemon):
        super().__init__(title="Clipboard History")
        self.daemon = daemon
        self._shown_ts = 0.0
        self._menu_open = False

        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.NONE)
        self.set_default_size(460, 480)
        self.stick()

        self.connect("key-press-event", self._on_key)
        self.connect("focus-out-event", self._on_focus_out)
        self.connect("delete-event", self._on_delete)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_margin_top(10)
        header.set_margin_bottom(6)
        header.set_margin_start(10)
        header.set_margin_end(10)
        self.search = Gtk.Entry()
        self.search.set_placeholder_text("Type to search clipboard history...")
        self.search.connect("changed", lambda *_: self.refresh())
        header.pack_start(self.search, True, True, 0)
        outer.pack_start(header, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_activate_on_single_click(False)
        self.listbox.connect("row-activated", self._on_row_activated)
        self.listbox.connect("button-press-event", self._on_list_click)
        self.placeholder = Gtk.Label(label="Clipboard history is empty")
        self.listbox.set_placeholder(self.placeholder)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)
        scrolled.add(self.listbox)
        outer.pack_start(scrolled, True, True, 0)

        footer = Gtk.Label(label="Enter: copy  |  Right-click: pin/delete  |  Esc: close")
        footer.get_style_context().add_class("dim-label")
        footer.set_margin_top(4)
        footer.set_margin_bottom(8)
        outer.pack_start(footer, False, False, 0)

        self.add(outer)
        self.refresh()

    # -- visibility ---------------------------------------------------------

    def show_dialog(self):
        self.search.set_text("")
        self.refresh()
        self._position_near_pointer()
        self._shown_ts = time.time()
        self.show_all()
        self.present()
        self.search.grab_focus()

    def hide_dialog(self):
        self.hide()

    def _position_near_pointer(self):
        """Place the dialog close to the mouse cursor. This requires the X11
        backend (the daemon forces GDK_BACKEND=x11): Wayland forbids clients
        from querying the pointer or positioning their windows."""
        display = Gdk.Display.get_default()
        px = py = None
        try:
            seat = display.get_default_seat()
            pointer = seat.get_pointer() if seat else None
            if pointer is not None:
                _screen, x, y = pointer.get_position()
                px, py = x, y
        except Exception:
            pass

        if not self.get_realized():
            self.realize()
        width, height = self.get_size()

        monitor = None
        if px is not None and (px > 0 or py > 0):
            try:
                monitor = display.get_monitor_at_point(px, py)
            except Exception:
                monitor = None
        if monitor is None:
            monitor = display.get_primary_monitor()
        if monitor is None and display.get_n_monitors() > 0:
            monitor = display.get_monitor(0)
        if monitor is None:
            return

        geo = monitor.get_geometry()
        if px is None or (px == 0 and py == 0):
            x = geo.x + max((geo.width - width) // 2, 8)
            y = geo.y + max((geo.height - height) // 2, 8)
        else:
            x = px + 18
            y = py + 18
        x = max(geo.x + 8, min(x, geo.x + geo.width - width - 8))
        y = max(geo.y + 8, min(y, geo.y + geo.height - height - 8))
        self.move(x, y)

    # -- events -------------------------------------------------------------

    def _on_delete(self, *_args):
        self.hide()
        return True

    def _on_focus_out(self, _widget, _event):
        if self._menu_open:
            return False
        if time.time() - self._shown_ts < SHOW_GRACE:
            return False
        self.hide()
        return False

    def _on_key(self, _widget, event):
        key = event.keyval
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)

        if key == Gdk.KEY_Escape:
            self.hide()
            return True
        if key == Gdk.KEY_Delete:
            self._delete_selected()
            return True
        if ctrl and key in (Gdk.KEY_p, Gdk.KEY_P):
            self._toggle_pin_selected()
            return True

        focused = self.get_focus()
        if focused is self.search:
            if key in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
                row = self.listbox.get_row_at_index(0)
                if row is not None:
                    self.listbox.select_row(row)
                    row.grab_focus()
                return True
            if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                row = self.listbox.get_row_at_index(0)
                if row is not None:
                    self._select_row(row)
                return True
        else:
            if key in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
                row = self.listbox.get_selected_row()
                if row is not None and row.get_index() == 0:
                    self.search.grab_focus()
                    return True
        return False

    def _on_list_click(self, _listbox, event):
        row = self.listbox.get_row_at_y(int(event.y))
        if row is None:
            return False
        if event.button == 1:
            self.listbox.select_row(row)
            self._select_row(row)
            return True
        if event.button == 3:
            self.listbox.select_row(row)
            self._popup_row_menu(row, event)
            return True
        return False

    def _on_row_activated(self, _listbox, row):
        self._select_row(row)

    # -- rows ---------------------------------------------------------------

    def refresh(self):
        query = self.search.get_text().strip().casefold()
        entries = self.daemon.store.all_sorted()
        if query:
            entries = [e for e in entries if query in e["content"].casefold()]
        for child in self.listbox.get_children():
            child.destroy()
        for e in entries:
            self.listbox.add(self._make_row(e))
        if query:
            self.placeholder.set_text("No matches")
        else:
            self.placeholder.set_text("Clipboard history is empty")

    def _make_row(self, entry):
        row = Gtk.ListBoxRow()
        row.entry_hash = sha1_text(entry["content"])

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(10)
        box.set_margin_end(10)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        preview = Gtk.Label(label=_preview_text(entry["content"]), xalign=0)
        preview.set_ellipsize(Pango.EllipsizeMode.END)
        preview.set_lines(2)
        preview.set_max_width_chars(44)
        star = "\u2605 pinned \u00b7 " if entry["pinned"] else ""
        meta = Gtk.Label(
            label="{}{} \u00b7 {} chars".format(
                star, _fmt_rel_time(entry["ts"]), len(entry["content"])
            ),
            xalign=0,
        )
        meta.get_style_context().add_class("dim-label")
        col.pack_start(preview, False, False, 0)
        col.pack_start(meta, False, False, 0)

        box.pack_start(col, True, True, 0)
        row.add(box)
        return row

    def _popup_row_menu(self, row, event):
        entry_hash = row.entry_hash
        entry = self.daemon.store.find(entry_hash)
        if entry is None:
            return
        menu = Gtk.Menu()

        item_copy = Gtk.MenuItem(label="Copy")
        item_copy.connect("activate", lambda *_: self._select_by_hash(entry_hash))
        menu.append(item_copy)

        menu.append(Gtk.SeparatorMenuItem())

        item_pin = Gtk.MenuItem(label="Unpin" if entry["pinned"] else "Pin")
        item_pin.connect(
            "activate",
            lambda *_: self.daemon.store.toggle_pin(entry_hash) or self.refresh(),
        )
        menu.append(item_pin)

        item_delete = Gtk.MenuItem(label="Delete")
        item_delete.connect(
            "activate",
            lambda *_: (self.daemon.store.remove(entry_hash), self.refresh()),
        )
        menu.append(item_delete)

        menu.connect("selection-done", self._on_menu_done)
        self._menu_open = True
        menu.show_all()
        menu.popup_at_pointer(event)

    def _on_menu_done(self, _menu):
        self._menu_open = False
        GLib.idle_add(self.refresh)

    # -- actions ------------------------------------------------------------

    def _select_row(self, row):
        self._select_by_hash(row.entry_hash)

    def _select_by_hash(self, entry_hash):
        entry = self.daemon.store.find(entry_hash)
        if entry is None:
            return
        self.daemon.mark_self(entry_hash)
        self.daemon.store.bump(entry_hash)   # picking counts as a copy: to top
        set_clipboard_text(entry["content"])
        self.hide()

    def _delete_selected(self):
        row = self.listbox.get_selected_row()
        if row is not None:
            self.daemon.store.remove(row.entry_hash)
            self.refresh()

    def _toggle_pin_selected(self):
        row = self.listbox.get_selected_row()
        if row is not None:
            self.daemon.store.toggle_pin(row.entry_hash)
            self.refresh()


# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------

class Daemon(object):
    def __init__(self):
        self.store = HistoryStore()
        self.store.load_wiping_unpinned()
        self.dialog = ClipboardDialog(self)
        self._stop = threading.Event()
        self._socket = None
        self._x11_last = None
        self._self_hash = None
        self._self_ts = 0.0

    # lifecycle -------------------------------------------------------------

    def start(self):
        self._start_socket()
        self._start_x11_watch()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self._on_signal)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self._on_signal)
        log("daemon started (pid {}, {} history entries)".format(
            os.getpid(), len(self.store.entries)))
        Gtk.main()

    def shutdown(self):
        if self._stop.is_set():
            return False
        self._stop.set()
        try:
            self._socket.close()
        except Exception:
            pass
        try:
            os.unlink(SOCKET_PATH)
        except OSError:
            pass
        self.store.save()
        log("daemon stopped")
        Gtk.main_quit()
        return False

    def _on_signal(self):
        self.shutdown()
        return GLib.SOURCE_REMOVE

    # socket server ---------------------------------------------------------

    def _start_socket(self):
        if os.path.exists(SOCKET_PATH):
            if daemon_is_running():
                raise SystemExit(
                    "{}: another daemon is already running".format(APP_NAME))
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCKET_PATH)
        os.chmod(SOCKET_PATH, 0o600)
        srv.listen(8)
        self._socket = srv
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def _accept_loop(self):
        while not self._stop.is_set():
            try:
                conn, _addr = self._socket.accept()
            except OSError:
                break
            with conn:
                reply = {"ok": False, "error": "unhandled"}
                try:
                    reply = self._dispatch(self._read_message(conn))
                except Exception as exc:
                    reply = {"ok": False, "error": str(exc)}
                try:
                    conn.sendall(json.dumps(reply).encode("utf-8") + b"\n")
                except OSError:
                    pass

    @staticmethod
    def _read_message(conn):
        buf = b""
        while b"\n" not in buf and len(buf) < MAX_WIRE_BYTES:
            chunk = conn.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.decode("utf-8", "replace"))

    def _dispatch(self, msg):
        cmd = msg.get("cmd")
        if cmd == "ping":
            return {"ok": True}
        if cmd == "ingest":
            self._to_gtk(self._ingest, msg.get("content"))
            return {"ok": True}
        if cmd == "toggle":
            self._to_gtk(self._toggle)
            return {"ok": True}
        if cmd == "show":
            self._to_gtk(self.dialog.show_dialog)
            return {"ok": True}
        if cmd == "hide":
            self._to_gtk(self.dialog.hide_dialog)
            return {"ok": True}
        if cmd == "quit":
            GLib.idle_add(self.shutdown)
            return {"ok": True}
        return {"ok": False, "error": "unknown command: {!r}".format(cmd)}

    @staticmethod
    def _to_gtk(fn, *args):
        """Run fn() on the GTK main thread and wait for its result."""
        if threading.current_thread() is threading.main_thread():
            return fn(*args)
        done = threading.Event()
        box = {}

        def run():
            try:
                box["result"] = fn(*args)
            except Exception as exc:      # noqa: BLE001 - report back to caller
                box["error"] = exc
            done.set()

        GLib.idle_add(run)
        if not done.wait(5.0):
            raise TimeoutError("GTK main thread is not responding")
        if "error" in box:
            raise box["error"]
        return box.get("result")

    # clipboard watching ----------------------------------------------------

    def _start_x11_watch(self):
        if not (os.environ.get("DISPLAY") and which("xclip")):
            log("warning: xclip/DISPLAY not available; clipboard watching disabled")
            return
        self._x11_last = read_clipboard_text()   # baseline: do NOT ingest
        threading.Thread(target=self._x11_loop, daemon=True).start()

    def _x11_loop(self):
        while not self._stop.wait(POLL_INTERVAL):
            text = read_clipboard_text()
            if text is None:
                continue
            if self._x11_last is not None and text != self._x11_last:
                try:
                    client({"cmd": "ingest", "content": text}, timeout=3.0)
                except OSError:
                    pass
            self._x11_last = text

    # GTK-thread callbacks --------------------------------------------------

    def _ingest(self, content):
        if not isinstance(content, str):
            return
        digest = sha1_text(content)
        if digest == self._self_hash and time.time() - self._self_ts < SELF_SET_TTL:
            return                                  # echo of our own set
        if self.store.ingest(content) and self.dialog.get_visible():
            self.dialog.refresh()

    def _toggle(self):
        if self.dialog.get_visible():
            self.dialog.hide_dialog()
        else:
            self.dialog.show_dialog()

    def mark_self(self, entry_hash):
        self._self_hash = entry_hash
        self._self_ts = time.time()


