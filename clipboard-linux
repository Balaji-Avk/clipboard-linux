def cmd_install(_args):
    os.makedirs(os.path.dirname(BIN_PATH), exist_ok=True)
    if SELF_PATH != BIN_PATH:
        shutil.copy2(SELF_PATH, BIN_PATH)
        os.chmod(BIN_PATH, 0o755)
        print("Installed binary: {}".format(BIN_PATH))
    else:
        print("Binary already in place: {}".format(BIN_PATH))

    repo_unit = os.path.join(os.path.dirname(SELF_PATH), "clipboard-linux.service")
    if os.path.isfile(repo_unit):
        with open(repo_unit, "r", encoding="utf-8") as fh:
            unit = fh.read()
    else:
        unit = UNIT_TEMPLATE
    os.makedirs(os.path.dirname(UNIT_PATH), exist_ok=True)
    with open(UNIT_PATH, "w", encoding="utf-8") as fh:
        fh.write(unit)
    print("Installed service: {}".format(UNIT_PATH))

    if not which("systemctl"):
        die("systemctl not found - cannot enable the user service")
    proc = subprocess.run(
        ["systemctl", "--user", "daemon-reload"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        die("systemctl daemon-reload failed: {}".format(proc.stderr.strip()))
    proc = subprocess.run(
        ["systemctl", "--user", "enable", "--now", APP_NAME],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        die("systemctl enable --now failed: {}".format(proc.stderr.strip()))
    print("Service enabled and started.")
    if not which("xclip"):
        print("WARNING: 'xclip' not found - clipboard watching needs it "
              "(apt install xclip).")
    if not which("wl-copy"):
        print("WARNING: 'wl-copy' not found - copying from the dialog needs it "
              "(apt install wl-clipboard).")
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    if os.path.dirname(BIN_PATH) not in path_dirs:
        print("NOTE: add {} to your PATH to run '{}' from a shell.".format(
            os.path.dirname(BIN_PATH), APP_NAME))
    print()
    cmd_shortcut_hint(_args)


def cmd_uninstall(args):
    if which("systemctl"):
        subprocess.run(
            ["systemctl", "--user", "disable", "--now", APP_NAME],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.path.exists(UNIT_PATH):
        os.remove(UNIT_PATH)
        print("Removed service: {}".format(UNIT_PATH))
    if which("systemctl"):
        subprocess.run(
            ["systemctl", "--user", "daemon-reload"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if getattr(args, "purge", False):
        if os.path.exists(BIN_PATH):
            os.remove(BIN_PATH)
            print("Removed binary: {}".format(BIN_PATH))
        shutil.rmtree(DATA_DIR, ignore_errors=True)
        print("Removed data: {}".format(DATA_DIR))
    else:
        print("Kept binary ({}) and data ({}); use --purge to remove them.".format(
            BIN_PATH, DATA_DIR))


def _existing_custom_bindings():
    """Best-effort list of (name, binding) for GNOME custom shortcuts."""
    out = []
    if not which("gsettings"):
        return out
    try:
        proc = subprocess.run(
            ["gsettings", "get", "org.gnome.settings-daemon.plugins.media-keys",
             "custom-keybindings"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
        paths = re.findall(r"'([^']+)'", proc.stdout)
        schema = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:"
        for path in paths:
            def get(prop):
                p = subprocess.run(
                    ["gsettings", "get", schema + path, prop],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, timeout=5)
                return p.stdout.strip().strip("'")
            out.append((get("name"), get("binding")))
    except (OSError, subprocess.TimeoutExpired):
        pass
    return out


def cmd_shortcut_hint(_args):
    conflicts = [
        (name, binding) for name, binding in _existing_custom_bindings()
        if binding and "<Super>v" in binding.replace(" ", "").lower()
    ]
    print("To open the clipboard history with Super+V, add a custom shortcut:")
    print()
    print("  GNOME Settings -> Keyboard -> Keyboard Shortcuts -> Custom Shortcuts")
    print("  -> '+' to add:")
    print()
    print("      Name:    Clipboard History")
    print("      Command: {} toggle".format(BIN_PATH))
    print("      Key:     Super+V")
    print()
    print("(Wayland does not let applications grab global keys themselves, so")
    print(" GNOME has to own the binding. Run '{} shortcut-hint' anytime.)".format(
        APP_NAME))
    if conflicts:
        print()
        print("WARNING: Super+V already appears to be used by:")
        for name, binding in conflicts:
            print("  - {} ({})".format(name or "(unnamed)", binding))
        print("Remove or change that binding, or pick another key for this one.")


# ---------------------------------------------------------------------------
# Daemon bootstrap + entry point
# ---------------------------------------------------------------------------

def _merge_systemd_user_env():
    """Pull display environment variables from the systemd user manager, which
    gnome-session populates at login (a service started early may not have them
    in its own environment yet)."""
    if not which("systemctl"):
        return
    try:
        proc = subprocess.run(
            ["systemctl", "--user", "show-environment"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, _sep, value = line.partition("=")
        if key and value:
            os.environ.setdefault(key, value)


def bootstrap_daemon_env():
    # Wait (up to ~30s) for the session display environment to appear; systemd
    # may start us slightly before gnome-session exports WAYLAND_DISPLAY.
    for _ in range(15):
        if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            break
        _merge_systemd_user_env()
        time.sleep(2)
    # Force the X11 backend: it is the only way to place the dialog near the
    # mouse cursor (Wayland forbids pointer queries and window positioning).
    # GNOME bridges the X11 and Wayland clipboards, so nothing is lost.
    if os.environ.get("DISPLAY") and "GDK_BACKEND" not in os.environ:
        os.environ["GDK_BACKEND"] = "x11"


def gtk_init():
    ok = Gtk.init_check()
    if isinstance(ok, tuple):
        ok = ok[0]
    if ok:
        return
    if os.environ.get("GDK_BACKEND") == "x11" and not os.environ.get("_CL_REEXEC"):
        # XWayland unavailable - retry with the default (Wayland) backend.
        env = dict(os.environ)
        env.pop("GDK_BACKEND", None)
        env["_CL_REEXEC"] = "1"
        os.execve(sys.executable, [sys.executable] + sys.argv, env)
    die("could not initialize GTK (no display?)")


def cmd_daemon(_args):
    bootstrap_daemon_env()
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        die("no display environment (DISPLAY/WAYLAND_DISPLAY unset); "
            "is this a graphical session?")
    gtk_init()
    daemon = Daemon()
    daemon.start()


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="Windows-style clipboard history dialog (Super+V) for Linux.")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("daemon", help="run the background daemon (used by the systemd service)")
    sub.add_parser("toggle", help="show the dialog, or hide it if visible")
    sub.add_parser("show", help="show the dialog")
    sub.add_parser("hide", help="hide the dialog")
    sub.add_parser("quit", help="stop the daemon")
    install_p = sub.add_parser("install", help="install binary + systemd user service")
    uninstall_p = sub.add_parser("uninstall", help="remove the systemd user service")
    uninstall_p.add_argument("--purge", action="store_true",
                             help="also remove the installed binary and stored data")
    sub.add_parser("shortcut-hint", help="print instructions for binding Super+V in GNOME")
    args = parser.parse_args(argv)

    commands = {
        "daemon": cmd_daemon,
        "toggle": cmd_toggle,
        "show": cmd_show,
        "hide": cmd_hide,
        "quit": cmd_quit,
        "install": cmd_install,
        "uninstall": cmd_uninstall,
        "shortcut-hint": cmd_shortcut_hint,
    }
    if args.command is None:
        parser.print_help()
        return 0
    commands[args.command](args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
