#!/usr/bin/env python3
"""clipboard-linux - Windows-style clipboard history (Super+V) for Linux desktops.

A systemd user service runs a small daemon in the background that:

  * watches the clipboard (via X11/XWayland, which GNOME bridges to Wayland),
  * keeps a rolling history of copied text (capped, oldest unpinned evicted),
  * shows a dialog on demand (bind it to Super+V) listing the history;
    picking an entry copies it back to the clipboard and closes the dialog.

On daemon start the history is wiped except pinned entries, so restarting the
service (or rebooting) starts you fresh but keeps what you deliberately pinned.

Commands:
  daemon           Run the background daemon (started by the systemd user service)
  toggle           Show the dialog, or hide it if it is already visible
  show / hide      Show or hide the dialog
  quit             Stop the daemon
  install          Install to ~/.local/bin + systemd user service, then enable it
  uninstall        Remove the systemd user service (--purge also removes the
                   installed binary and stored data)
  shortcut-hint    Print instructions for binding Super+V in GNOME settings
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

APP_NAME = "clipboard-linux"
MAX_ENTRIES = 100
MAX_CONTENT_CHARS = 256 * 1024
MAX_WIRE_BYTES = 4 * 1024 * 1024
POLL_INTERVAL = 0.6            # seconds between clipboard polls
SELF_SET_TTL = 5.0             # ignore clipboard echoes of our own copies (seconds)
SHOW_GRACE = 0.35              # ignore focus-out events right after showing (seconds)

HOME = os.path.expanduser("~")
DATA_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), APP_NAME
)
HISTORY_FILE = os.path.join(DATA_DIR, "history.json")
BIN_PATH = os.path.join(HOME, ".local", "bin", APP_NAME)
UNIT_PATH = os.path.join(HOME, ".config", "systemd", "user", APP_NAME + ".service")
SELF_PATH = os.path.abspath(os.path.realpath(sys.argv[0]))

UNIT_TEMPLATE = """\
[Unit]
Description=Clipboard history daemon (Super+V clipboard manager)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/clipboard-linux daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target graphical-session.target
"""


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp/{}-{}".format(APP_NAME, os.getuid())
    try:
        os.makedirs(base, exist_ok=True)
    except OSError:
        pass
    return base


SOCKET_PATH = os.path.join(runtime_dir(), APP_NAME + ".sock")


def sha1_text(text):
    return hashlib.sha1(text.encode("utf-8", "replace")).hexdigest()


def log(msg):
    sys.stderr.write("[{}] {}\n".format(APP_NAME, msg))
    sys.stderr.flush()


def die(msg, code=1):
    sys.stderr.write("{}: error: {}\n".format(APP_NAME, msg))
    sys.exit(code)


def which(name):
    return shutil.which(name)


# ---------------------------------------------------------------------------
# Client side (talk to a running daemon over its unix socket)
# ---------------------------------------------------------------------------

def client(msg, timeout=3.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET_PATH)
        s.sendall(json.dumps(msg).encode("utf-8") + b"\n")
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        if not buf:
            raise OSError("daemon closed the connection")
        return json.loads(buf.decode("utf-8", "replace"))
    finally:
        s.close()


def daemon_is_running():
    try:
        return bool(client({"cmd": "ping"}, timeout=0.6).get("ok"))
    except (OSError, ValueError):
        return False


def ensure_daemon_running():
    if daemon_is_running():
        return True
    if os.path.exists(UNIT_PATH) and which("systemctl"):
        subprocess.run(
            ["systemctl", "--user", "start", APP_NAME],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        deadline = time.time() + 10.0
        while time.time() < deadline:
            if daemon_is_running():
                return True
            time.sleep(0.3)
    return False


def cmd_toggle(_args):
    if not ensure_daemon_running():
        die(
            "daemon is not running (install it with '{} install')".format(APP_NAME)
        )
    reply = client({"cmd": "toggle"})
    if not reply.get("ok"):
        die(reply.get("error", "toggle failed"))


def cmd_show(_args):
    if not ensure_daemon_running():
        die("daemon is not running (install it with '{} install')".format(APP_NAME))
    client({"cmd": "show"})


def cmd_hide(_args):
    if not ensure_daemon_running():
        die("daemon is not running (install it with '{} install')".format(APP_NAME))
    client({"cmd": "hide"})


def cmd_quit(_args):
    try:
        client({"cmd": "quit"})
    except OSError:
        pass


# ---------------------------------------------------------------------------
# History store
# ---------------------------------------------------------------------------

class HistoryStore(object):
    """Rolling clipboard history persisted as JSON.

    Entries are dicts: {"content": str, "ts": float, "pinned": bool}.
    """

    def __init__(self):
        self.entries = []

    def load_wiping_unpinned(self):
        """Load history from disk, keeping pinned entries only (by design:
        restarting the service erases everything except pinned values)."""
        raw = []
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as fh:
                raw = json.load(fh).get("entries", []) or []
        except (OSError, ValueError):
            raw = []
        kept = []
        for e in raw:
            content = e.get("content")
            if e.get("pinned") and isinstance(content, str) and content.strip():
                if len(content) > MAX_CONTENT_CHARS:
                    content = content[:MAX_CONTENT_CHARS]
                kept.append(
                    {"content": content, "ts": float(e.get("ts") or time.time()),
                     "pinned": True}
                )
        kept.sort(key=lambda e: -e["ts"])
        self.entries = kept
        self.save()

    def save(self):
        try:
            os.makedirs(DATA_DIR, exist_ok=True)
            tmp = HISTORY_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump({"version": 1, "entries": self.entries}, fh)
            os.replace(tmp, HISTORY_FILE)
        except OSError as exc:
            log("could not save history: {}".format(exc))

    def all_sorted(self):
        """Pinned first, then most recent first."""
        return sorted(self.entries, key=lambda e: (0 if e["pinned"] else 1, -e["ts"]))

    def find(self, entry_hash):
        for e in self.entries:
            if sha1_text(e["content"]) == entry_hash:
                return e
        return None

    def ingest(self, content):
        """Add new clipboard content. Returns True if history changed."""
        if not isinstance(content, str) or not content.strip():
            return False
        if len(content) > MAX_CONTENT_CHARS:
            content = content[:MAX_CONTENT_CHARS]
        now = time.time()
        digest = sha1_text(content)
        for i, e in enumerate(self.entries):
            if sha1_text(e["content"]) == digest:
                self.entries.pop(i)
                e["ts"] = now           # copying something again bumps it to top
                self.entries.insert(0, e)
                self.save()
                return True
        self.entries.insert(0, {"content": content, "ts": now, "pinned": False})
        self._evict()
        self.save()
        return True

    def _evict(self):
        while len(self.entries) > MAX_ENTRIES:
            victim = None
            for i in range(len(self.entries) - 1, -1, -1):
                if not self.entries[i]["pinned"]:
                    victim = i
                    break
            if victim is None:      # everything is pinned; keep the overflow
                break
            self.entries.pop(victim)

    def bump(self, entry_hash):
        """Move an entry to the top with a fresh timestamp (picking it from the
        dialog counts as a copy, same as in the Windows clipboard history)."""
        e = self.find(entry_hash)
        if e is None:
            return
        self.entries.remove(e)
        e["ts"] = time.time()
        self.entries.insert(0, e)
        self.save()

    def remove(self, entry_hash):
        e = self.find(entry_hash)
        if e is not None:
            self.entries.remove(e)
            self.save()

    def toggle_pin(self, entry_hash):
        e = self.find(entry_hash)
        if e is None:
            return None
        e["pinned"] = not e["pinned"]
        self.save()
        return e["pinned"]


# ---------------------------------------------------------------------------
# Clipboard access
# ---------------------------------------------------------------------------

def read_clipboard_text():
    """Read the clipboard as text via XWayland. Returns None if the clipboard
    is empty, unreadable, or holds non-text content (e.g. an image).

    On GNOME, X11 selections are bridged to the Wayland clipboard, so this
    sees copies made by both Wayland and X11 applications.
    """
    if not (os.environ.get("DISPLAY") and which("xclip")):
        return None
    try:
        proc = subprocess.run(
            ["xclip", "-selection", "clipboard", "-o", "-target", "UTF8_STRING"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0 or not proc.stdout:
        return None
    return proc.stdout.decode("utf-8", "replace")


def set_clipboard_text(content):
    data = content.encode("utf-8")
    if os.environ.get("WAYLAND_DISPLAY") and which("wl-copy"):
        try:
            subprocess.run(
                ["wl-copy", "--type", "text/plain;charset=utf-8"],
                input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=3,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            log("wl-copy failed: {}".format(exc))
    if os.environ.get("DISPLAY") and which("xclip"):
        try:
            subprocess.run(
                ["xclip", "-selection", "clipboard", "-in"],
                input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=3,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            log("xclip failed: {}".format(exc))


